<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.Tooltip?>

<StackPane id="mainAnchorPane" fx:id="mainStackPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
           minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="yourmusic.app.Controller">
    <VBox alignment="CENTER" spacing="8.0" styleClass="main-background-color">
        <Button styleClass="big-button" mnemonicParsing="false" onAction="#btnFolder" prefHeight="30.0"
                prefWidth="350.0" text="Folder">
            <tooltip>
                <Tooltip text="Choose music folder"/>
            </tooltip>
        </Button>

        <TextField fx:id="fieldSearch" prefHeight="30.0" prefWidth="350.0" promptText="Search"/>

        <ListView fx:id="listView" prefHeight="400.0" prefWidth="350.0"/>

        <HBox spacing="8" alignment="CENTER" maxWidth="350.0" prefWidth="350.0">
            <Label fx:id="labelTimeStart" minWidth="42.0" prefWidth="42.0" text="00:00"/>
            <Slider fx:id="timeLineMusic" HBox.hgrow="ALWAYS" prefHeight="24.0"/>
            <Label fx:id="labelTimeEnd" alignment="CENTER_RIGHT" minWidth="42.0" prefWidth="42.0" text="00:00"/>
        </HBox>

        <StackPane maxWidth="350.0">
            <HBox spacing="20" alignment="CENTER">
                <ToggleButton fx:id="btnRandomMusic" mnemonicParsing="false">
                    <tooltip>
                        <Tooltip text="Shuffle"/>
                    </tooltip>
                    <graphic>
                        <SVGPath styleClass="svg-path, svg-path-toggle-button"
                                 content="M18 14 l4 4 -4 4 M18 2 l4 4 -4 4 M2 18h1.973a4 4 0 0 0 3.3-1.7l5.454-8.6a4 4 0 0 1 3.3-1.7H22 M2 6h1.972a4 4 0 0 1 3.6 2.2 M22 18h-6.041a4 4 0 0 1-3.3-1.8l-.359-.45"/>
                    </graphic>
                </ToggleButton>
                <Button fx:id="btnPreviousMusic" mnemonicParsing="false">
                    <tooltip>
                        <Tooltip text="Previous track"/>
                    </tooltip>
                    <graphic>
                        <SVGPath styleClass="svg-path"
                                 content="M17.971 4.285A2 2 0 0 1 21 6v12a2 2 0 0 1-3.029 1.715l-9.997-5.998a2 2 0 0 1-.003-3.432z M3 20V4"/>
                    </graphic>
                </Button>

                <ToggleButton fx:id="btnPauseUnpause" mnemonicParsing="false">
                    <tooltip>
                        <Tooltip text="Play / Pause"/>
                    </tooltip>
                    <graphic>
                        <StackPane minWidth="24.0" minHeight="24.0" prefWidth="24.0" prefHeight="24.0" maxWidth="24.0"
                                   maxHeight="24.0">
                            <SVGPath fx:id="iconPlayPause" styleClass="svg-path"
                                     content="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>

                <Button fx:id="btnNextMusic" mnemonicParsing="false">
                    <tooltip>
                        <Tooltip text="Next track"/>
                    </tooltip>
                    <graphic>
                        <SVGPath styleClass="svg-path"
                                 content="M21 4v16 M6.029 4.285A2 2 0 0 0 3 6v12a2 2 0 0 0 3.029 1.715l9.997-5.998a2 2 0 0 0 .003-3.432z"/>
                    </graphic>
                </Button>

                <ToggleButton fx:id="btnRepeatMusic" mnemonicParsing="false">
                    <tooltip>
                        <Tooltip text="Repeat track"/>
                    </tooltip>
                    <graphic>
                        <SVGPath styleClass="svg-path, svg-path-toggle-button"
                                 content="M17 2 l4 4 -4 4 M3 11v-1a4 4 0 0 1 4-4h14 M7 22 l-4 -4 4 -4 M21 13v1a4 4 0 0 1-4 4H3"/>
                    </graphic>
                </ToggleButton>
            </HBox>

            <Button fx:id="reloadMusic" StackPane.alignment="CENTER_RIGHT" mnemonicParsing="false"
                    onAction="#reloadMusic">
                <tooltip>
                    <Tooltip text="Reload playlist"/>
                </tooltip>
                <graphic>
                    <SVGPath styleClass="svg-path"
                             content="M21 5H3 M7 12H3 M7 19H3 M12 18a5 5 0 0 0 9-3 4.5 4.5 0 0 0-4.5-4.5c-1.33 0-2.54.54-3.41 1.41L11 14 M11 10v4h4"/>
                </graphic>
            </Button>
        </StackPane>

        <Slider fx:id="volumeMusic" layoutX="105.0" layoutY="565.0" prefWidth="150.0" onMouseReleased="#changeVolume">
            <padding>
                <Insets left="30.0" right="30.0"/>
            </padding>
        </Slider>

        <padding>
            <Insets bottom="10.0" left="16.0" right="16.0" top="8.0"/>
        </padding>
    </VBox>
</StackPane>
